# Copy this file to .env and fill in the keys you have.
# Any provider left blank is skipped gracefully by the transcription fallback router.

OPENAI_API_KEY=
SMALLEST_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional: gate the API behind a shared-secret key (e.g. for a public demo
# deploy). Leave blank for local dev — auth is fully disabled when unset.
API_KEY=
